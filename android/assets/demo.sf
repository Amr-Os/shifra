# ==============================================
#   شِفرة — عرض شامل لكل ما تم تفعيله
#   Demo of every Shifra feature (run with RustPython)
# ==============================================

# ---------- ١) المتغيرات، الأرقام العربية، العمليات ----------    
كمية = ١٠
سعر = ٣.٥
المجموع = كمية * سعر + ٥
اطبع("١) المجموع =", المجموع)
اطبع("   مطلق:", مطلق(-٧))
اطبع("   دور:", دور(٣.٧))
اطبع("   قوة:", قوة(٢, ١٠))
اطبع("   قسمة مع باقي:", قسمة_باقية(١٧, ٥))
اطبع("   ثنائي/ثماني/ست_عشري:", ثنائي(١٠), ثماني(١٠), ست_عشري(٢٥٥))

# ---------- ٢) النصوص والحروف ----------
اسم = "رنا"
اطبع("٢) كبر:", اسم.كبر(), "| صغر:", "مرحبا".صغر())
اطبع("   حرف_الأول:", "sALAM".حرف_الأول())
اطبع("   حرف:", حرف(٦٤), "| رمز_الحرف:", رمز_الحرف("أ"))
اطبع("   أسكي/تمثيل:", أسكي("مرحبا"), تمثيل("مرحبا"))
اطبع("   بدل_الحالة:", "Shifra شيفرة".بدل_الحالة())
اطبع("   بعناوين:", "مرحبا بك في الشفرة".بعناوين())

# ---------- ٣) نصوص متعددة الأسطر + الهروب ----------
اطبع("٣) الهروب:")
اطبع("   سطر ١\جسطر ٢\جسطر ٣")
اطبع("   أعمدة:\طاسم\طالعمر\طالمدينة")
اطبع("   رجوع:\ر موضع")
اطبع(r"   نص خام: \ج لا يتحول")
اطبع("   مسار:\مج الفصل:\مل")
اطبع("   صفر\ص تبويب", "نهاية\ن")

# ---------- ٤) القوائم: كل الدوال ----------
مهام = قائمة()
مهام.أضف("دراسة")
مهام.أضف("عمل")
مهام.أضف("نوم")
مهام.ادرج(١, "رياضة")
اطبع("٤) قائمة أولية:", مهام)
مهام.رتب()
اطبع("   بعد الرتب:", مهام)
مهام.عكس()
اطبع("   بعد العكس:", مهام)
اطبع("   العد:", مهام.عد("نوم"), "| الموقع:", مهام.موقع("نوم"))
مهام.احذف("رياضة")
اطبع("   بعد احذف:", مهام)
مهام.اخرج()
اطبع("   بعد اخرج:", مهام)
مهام.مدد(["مزيد", "أشياء"])
اطبع("   بعد مدد:", مهام)
نسخة = مهام.انسخ()
نسخة.امسح()
اطبع("   النسخة بعد امسح فارغة:", نسخة)

# ---------- ٥) القوائم: بايئة comprehension ----------
مربعات = [س * س لكل س ضمن نطاق(٦)]
زواجية = [س لكل س ضمن نطاق(١٠) إذا س % ٢ == ٠]
اطبع("٥) مربعات:", مربعات)
اطبع("   زوجية:", زواجية)

# ---------- ٦) السلاسل: كل الدوال ----------
جملة = "مرحبا بك في عالم البرمجة"
كلمات = جملة.قسم(" ")
اطبع("٦) قسم:", كلمات)
اطبع("   اربط:", "-".اربط(كلمات))
اطبع("   يبدأ_ب:", جملة.يبدأ_ب("مرحبا"), "| ينتهي_ب:", جملة.ينتهي_ب("عالم"))
اطبع("   ابحث:", جملة.ابحث("عالم"))
اطبع("   استبدل:", جملة.استبدل("برمجة", "شيفرة"))
اطبع("   جرد:", "    مسافة زائدة    ".جرد() + ";")
اطبع("   احذف_بادئة:", جملة.احذف_بادئة("مرحبا "))
اطبع("   وسيط:", "نص".وسط(٩, "•"))
اطبع("   نسق:", "{} يبلغ {} سنوات".نسق("أحمد", ١٢))
اطبع("   املأ_اصفار:", "٤٢".املأ_اصفار(٥))
اطبع("   هل_رقم/هل_حروف:", "١٢٣".هل_رقم(), "مرحبا".هل_حروف())
قسمة = جملة.اقتسم(" في ")
اطبع("   اقتسم:", قسمة[٠], "|", قسمة[٢])

# ---------- ٧) القواميس: كل الدوال ----------
طالب = قاموس()
طالب["الاسم"] = "ليلى"
طالب.عين_مبدئي("العمر", ١٤)
طالب.عين_مبدئي("المدينة", "الرياض")
اطبع("٧) قاموس:", طالب)
اطبع("   اجلب:", طالب.اجلب("الاسم"), "| اجلب بافتراضي:", طالب.اجلب("الهاتف", "لا يوجد"))
اطبع("   مفاتيح:", قائمة(طالب.مفاتيح()))
اطبع("   قيم:", قائمة(طالب.قيم()))
اطبع("   عناصر:", قائمة(طالب.عناصر()))
أخرى = {"الهاتف": "٥٥٥", "البريد": "lela@x"}
طالب.دمج(أخرى)
اطبع("   بعد دمج:", طالب)
اطبع("   اخرج_آخر:", طالب.اخرج_آخر())
مصفوفة_جدول = قاموس.من_مفاتيح(["أ", "ب", "ج"], ٠)
اطبع("   من_مفاتيح:", مصفوفة_جدول)

# ---------- ٨) المجموعات: كل الدوال ----------
المجموعة = مجموعة([١, ٢, ٣])
المجموعة.ضم(٤)
ضم_أخرى = {٣, ٤, ٥}
اطبع("٨) مجموعة:", المجموعة)
اطبع("   اتحاد:", المجموعة.اتحاد(ضم_أخرى))
اطبع("   تقاطع:", المجموعة.تقاطع(ضم_أخرى))
اطبع("   فرق:", المجموعة.فرق(ضم_أخرى))
اطبع("   فرق_متماثل:", المجموعة.فرق_متماثل(ضم_أخرى))
اطبع("   مجموعة_فرعية:", {١}.مجموعة_فرعية(المجموعة))
اطبع("   منفصل:", المجموعة.منفصل({٩, ١٠}))
المجموعة.تجاهل(٤)
المجموعة.فرق_حدث({١})
المجموعة.تقاطع_حدث({٢, ٣, ٩})
اطبع("   بعد تجاهل وفرق_حدث وتقاطع_حدث:", المجموعة)

# ---------- ٩) المولدات (انتج) ----------
عرف أعداد_زوجية(الحد):
    ن = ٠
    طالما ن < الحد:
        انتج ن
        ن += ٢

اطبع("٩) أعداد زوجية:", قائمة(أعداد_زوجية(١٠)))

# ---------- ١٠) البنيات: while / break / continue ----------
عرف عد_تنازلي(البداية):
    ن = البداية
    النتيجة = قائمة()
    طالما صحيح:
        إذا ن <= ٠:
            توقف
        النتيجة.أضف(ن)
        ن -= ١
    أعد النتيجة

اطبع("١٠) تنازلي:", عد_تنازلي(٥))

يتحقق = ٠
لكل ن ضمن نطاق(١٠):
    إذا ن % ٣ == ٠:
        استمر
    يتحقق += ١
اطبع("    استمر: تخطينا المضاعفات، العدد:", يتحقق)

# ---------- ١١) الشروط (if/elif/else) ----------
عرف تصنيف(رقم_):
    إذا رقم_ > ٩٩:
        أعد "كبير جدا"
    وإذا رقم_ > ٩:
        أعد "متوسط"
    وإلا:
        أعد "صغير"

اطبع("١١)", تصنيف(٥), تصنيف(٥٠), تصنيف(٥٠٠))

# الشروط السطرية (one-line + ternary)
سن = ٢٠
إذا سن >= ١٨: اطبع("١١) بالغ") وإلا: اطبع("١١) قاصر")
الوصف = "جيد" إذا مجموع(مربعات) > ٥٠ وإلا "ضعيف"
اطبع("١١) وصفي:", الوصف)

# ---------- ١٢) البوليانية ----------
اطبع("١٢) و/أو/ليس:", صحيح و خاطئ, صحيح أو خاطئ, ليس خاطئ)
قائمة_أ = [١, ٢]
قائمة_ب = [١, ٢]
اطبع("١٢) الهوية (is):", قائمة_أ هو قائمة_أ, قائمة_أ هو قائمة_ب)
اطبع("    ضمن:", "رنا" ضمن ["رنا", "سارة"])
اطبع("    عدم:", عدم هو عدم)

# ---------- ١٣) الدوال المدمجة الأعلى رتبة ----------
أرقام = [٤, ٢, ٦, ٩, ١, ٣]
اطبع("١٣) مرتب:", مرتب(أرقام))
اطبع("    معكوس:", قائمة(معكوس(أرقام)))
اطبع("    طبق (قائمة):", قائمة(طبق(لامبدا س: س * س, أرقام)))
اطبع("    رشح:", قائمة(رشح(لامبدا س: س > ٣, أرقام)))
اطبع("    مجموع:", مجموع(أرقام), "| اصغر:", اصغر(أرقام), "| اكبر:", اكبر(أرقام))
اطبع("    الكل:", الكل(أرقام), "| أي:", أي(أرقام))
اطبع("    ترقيم:", قائمة(ترقيم(أرقام[:٣])))
اطبع("    دمج:", قائمة(دمج(["أ", "ب"], [١, ٢])))
اطبع("    كرر/التالي:", التالي(كرر([١٠, ٢٠])))

# ---------- ١٤) الأنواع والتحويل ----------
اطبع("١٤) عدد:", عدد("٤٢") + ٨, "| كسري:", كسري("٣.١٤"))
اطبع("    نص:", نص(١٠٠), "| منطقي:", منطقي(١), مركب(٤, ٥))
اطبع("    متسلسلة:", متسلسلة(أرقام[:٣]), "| بايت:", "أب".رمز(), "| بيتات:", بيتات([٦٥, ٦٦]))
اطبع("    مثيل:", مثيل(٥, عدد), مثيل([], قائمة))
بايتات = "سلام".رمز()
اطبع("    بايت فك/ست_عشري:", بايتات.فك_رمز(), بايتات.ست_عشري())

# ---------- ١٥) الصفوف (classes) ----------
صنف حيوان:
    عرف __التهيئة__(الذات, الاسم, الصوت):
        الذات.الاسم = الاسم
        الذات.الصوت = الصوت

    عرف نطق(الذات):
        أعد الذات.الاسم + " يقول: " + الذات.الصوت

قط = حيوان("قط", "مياو")
كلب = حيوان("كلب", "هوو")
اطبع("١٥)", قط.نطق())
اطبع("    ", كلب.نطق())
اطبع("    مشتق:", مشتق(حيوان, كائن))
اطبع("    اجلب_سمة:", اجلب_سمة(قط, "الاسم"))

# ---------- ١٦) الاستثناءات (try / except / finally) ----------
جرب:
    ارم خطأ_قيمة("قيمة غير صالحة!")
التقط خطأ_قيمة باسم خطأ:
    اطبع("١٦) التقطنا:", خطأ)
التقط خطأ:
    اطبع("١٦) خطأ عام")
ختاما:
    اطبع("١٦) ختاما يعمل دائما")

عرف قسمة_آمنة(أ, ب):
    تحقق ب != ٠, "لا يمكن القسمة على صفر!"
    أعد أ / ب

اطبع("١٦) قسمة آمنة:", قسمة_آمنة(١٠, ٤))

# ---------- ١٧) الفحص الذاتي (introspection) ----------
اطبع("١٧) حجم قائمة:", طول(مهام))
اطبع("    دليل جزئي:", دليل(قائمة)[:٥])
اطبع("    هوية:", هوية(أرقام) == هوية(أرقام))
اطبع("    هاش:", هاش("نص"))
اطبع("    استدعائي:", استدعائي(اطبع), استدعائي(٥))
اطبع("    شريحة:", أرقام[شريحة(١, ٤)])
اطبع("    عرض_الذاكرة:", قائمة(عرض_الذاكرة("أب".رمز())))
اطبع("    قيم (eval):", قيم("1 + 2"))

# ---------- ١٨) الكتل: with / match ----------
صنف مدير_الملفات:
    عرف __enter__(الذات):
        اطبع("١٨) فتح المورد...")
        أعد الذات
    عرف __exit__(الذات, النوع, القيمة, الأثر):
        اطبع("١٨) إغلاق المورد...")
        أعد خاطئ

مع مدير_الملفات() باسم المدير:
    اطبع("١٨) داخل الكتلة")

نتيجة = "ب"
طابق نتيجة:
    حالة "أ":
        اطبع("١٨) النتيجة: أ")
    حالة "ب":
        اطبع("١٨) النتيجة: ب")
    حالة _:
        اطبع("١٨) النتيجة: أخرى")

# ---------- ١٩) العالمية و local / globals ----------
العداد = ٠
عرف زيادة():
    عام العداد
    العداد += ١
    أعد العداد

زيادة()
زيادة()
اطبع("١٩) بعد زيادتين:", العداد)
اطبع("     عالميات فيها 'العداد':", "العداد" ضمن عالميات())
اطبع("     متغيرات:", طول(متغيرات()) >= ١)

# ---------- ٢٠) async (يُعرَّف فقط) ----------
لازمني عرف معالجة():
    أعد "تم"
لازمني عرف سير_عمل():
    نتيجة = انتظر معالجة()
    أعد نتيجة

اطبع("٢٠) تم تعريف دالة غير متزامنة:", نص(سير_عمل).يبدأ_ب("<function"))

# ---------- ٢١) التصفية مع explicit del ----------
المؤقت = قائمة([١, ٢, ٣])
احذف المؤقت[١]
اطبع("٢١) بعد del:", المؤقت)
احذف المؤقت
اطبع("     تم حذف المؤقت")

# ---------- ٢٢) الاستيراد ----------
استورد json
بيانات = {"الاسم": "شيفرة", "الإصدار": "0.2.10"}
اطبع("٢٢)", json.dumps(بيانات, ensure_ascii=ليس صحيح))