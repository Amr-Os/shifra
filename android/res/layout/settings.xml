<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true"
    android:scrollbars="none"
    android:layoutDirection="rtl">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/header_snips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingBottom="4dp"
            android:text="@string/settings_snippets"
            android:textColor="@color/accent"
            android:textSize="16sp"/>

        <EditText
            android:id="@+id/snips_edit"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:gravity="top|right"
            android:textDirection="rtl"
            android:textSize="12sp"
            android:typeface="monospace"
            android:textColor="@color/text"
            android:textColorHint="@color/text_dim"
            android:backgroundTint="@color/surface"
            android:hint="@string/settings_snippets_hint"
            android:inputType="textMultiLine|textNoSuggestions"/>

        <Button
            android:id="@+id/snips_save"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/save"
            android:textColor="@color/text_on_accent"
            android:backgroundTint="@color/accent"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:background="@color/divider"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:paddingBottom="4dp"
            android:text="@string/settings_font"
            android:textColor="@color/accent"
            android:textSize="16sp"/>

        <Spinner
            android:id="@+id/font_spinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/size_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:paddingBottom="2dp"
            android:text="@string/settings_font_size"
            android:textColor="@color/text"/>

        <SeekBar
            android:id="@+id/size_seek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="14"/>

        <Switch
            android:id="@+id/wrap_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="16dp"
            android:text="@string/settings_wrap"
            android:textColor="@color/text"/>
    </LinearLayout>
</ScrollView>