# اختبار متكامل: دوال راجعة، استيعاب القوائم، قواميس، حلقات، واستثناءات.

عرف فيبوناتشي(ن):
    إن ن < 2:
        أعد ن
    أعد فيبوناتشي(ن - 1) + فيبوناتشي(ن - 2)

درجات = [12, 18, 15, 20, 17]
مربعات = [قيمة * قيمة لكل قيمة ضمن نطاق(1, 6)]

سجل = {
    "الاسم": "ليان",
    "الدرجات": درجات,
    "المعدل": عدم,
    "مفعل": صحيح,
}

المجموع = 0
لكل درجة ضمن سجل["الدرجات"]:
    المجموع += درجة

جرب:
    إن سجل["المعدل"] هو عدم و سجل["مفعل"]:
        سجل["المعدل"] = المجموع / طول(سجل["الدرجات"])
    ارم خطأ_قيمة("اختبار مسار الاستثناء")
التقط خطأ_قيمة باسم خطأ:
    اطبع("تم التقاط الاستثناء:", خطأ)
ختاما:
    اطبع("الاسم:", سجل["الاسم"])
    اطبع("المربع الأخير:", مربعات[-1])
    اطبع("المعدل:", سجل["المعدل"])

اطبع("فيبوناتشي 8:", فيبوناتشي(8))
