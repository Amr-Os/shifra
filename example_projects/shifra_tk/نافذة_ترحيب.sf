# =======================================================
#  شيفرة + tkinter — نافذة ترحيب
#  عرض نافذة فيها عنوان ونص وزر (اختبار tkinter في شيفرة)
# =======================================================

استورد tkinter

الجذر = tkinter.Tk()
الجذر.title("مرحبا من شيفرة")
الجذر.geometry("320x200")

النص = tkinter.Label(الجذر, text="أهلا بك في عالم شيفرة مع tkinter")
النص.pack(pady=20)

عرف عند_الضغط():
    النص.config(text="تم الضغط على الزر! عملت شيفرة + tkinter")

الزر = tkinter.Button(الجذر, text="اضغطني", command=عند_الضغط)
الزر.pack(pady=10)

الجذر.mainloop()
