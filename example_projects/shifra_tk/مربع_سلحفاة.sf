# =======================================================
#  شيفرة + turtle — رسم مربع ملون
#  سلحفاة ترسم مربعاً (اختبار turtle في شيفرة)
# =======================================================

استورد turtle

السلحفاة = turtle.Turtle()
السلحفاة.speed(5)
السلحفاة.pensize(3)
السلحفاة.color("blue")

لكل ضلع ضمن نطاق(٤):
    السلحفاة.forward(100)
    السلحفاة.left(90)

turtle.done()
