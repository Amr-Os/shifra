# =======================================================
#  شيفرة + turtle — نجمة/حلزون ملون
#  سلحفاة ترسم حلزوناً متغيّر الألوان (اختبار turtle)
# =======================================================

استورد turtle

السلحفاة = turtle.Turtle()
السلحفاة.speed(8)
السلحفاة.pensize(2)

الألوان = ["red", "orange", "green", "blue", "purple"]

لكل مؤشر ضمن نطاق(٦٠):
    السلحفاة.pencolor(الألوان[مؤشر % طول(الألوان)])
    السلحفاة.forward(مؤشر * ٣)
    السلحفاة.left(٥٩)

turtle.done()
