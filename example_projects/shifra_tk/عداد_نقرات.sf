# =======================================================
#  شيفرة + tkinter — عدّاد نقرات
#  زر يزيد عدّاداً عند كل ضغطة (اختبار tkinter في شيفرة)
# =======================================================

استورد tkinter
# استورد
العداد = ٠

الجذر = tkinter.Tk()
الجذر.title("عداد النقرات")
الجذر.geometry("240x120")

عرض = tkinter.Label(الجذر, text="النقرات: ٠")
عرض.pack(pady=20)

عرف زيادة():
    عام العداد
    العداد += ١
    عرض.config(text="النقرات: " + نص(العداد))

الزر = tkinter.Button(الجذر, text="انقر هنا", command=زيادة)
الزر.pack()

الجذر.mainloop()
