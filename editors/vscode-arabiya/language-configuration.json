{
  "comments": {
    "lineComment": "#"
  },
  "brackets": [["{", "}"], ["[", "]"], ["(", ")"]],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] },
    { "open": "'", "close": "'", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [["{", "}"], ["[", "]"], ["(", ")"], ["\"", "\""], ["'", "'"]],
  "wordPattern": "(-?\\d*\\.?\\d+)|([\\p{L}_][\\p{L}\\p{N}_]*)",
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(?!#).*:\\s*(?:#.*)?$",
    "decreaseIndentPattern": "^\\s*(?:وإلا(?:_إن)?|التقط|ختاما)(?:\\s|:|$).*"
  }
}
